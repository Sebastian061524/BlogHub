<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Spring Boot父项目提供依赖版本和构建约定，具体功能由所选依赖及应用配置决定。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.sebastian</groupId>
    <artifactId>bloghub</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>bloghub</name>
    <description>bloghub</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <!-- 项目使用Java 17作为编译目标，构建环境需提供匹配JDK。 -->
    <properties>
        <java.version>17</java.version>
    </properties>
    <!-- 依赖按Web、持久化、校验、密码编码和JWT等职责组合。 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- Spring MVC依赖集合，用于Controller和HTTP请求响应处理。 -->
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <!-- MyBatis与Spring Boot集成，配合@Mapper接口及XML执行SQL。 -->
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <!-- MySQL JDBC驱动，runtime表示运行时连接数据库需要。 -->
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- Web测试依赖，仅在测试作用域使用；此处不代表已验证全部Starter行为。 -->
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <!-- Lombok注解处理器在编译期生成@Data等样板代码，此处声明为provided作用域。 -->
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- Bean Validation集成，支持DTO中的@NotBlank和@Size等约束。 -->
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <!-- BCrypt等密码编码工具；认证请求流程由项目自己的代码实现。 -->
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <!-- JWT构建、验签及Claims等公开API，供JwtUtil编译使用。 -->
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <!-- JJWT运行时实现，与API使用相同版本。 -->
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <!-- JJWT的Jackson JSON序列化和反序列化支持。 -->
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <!-- Spring Boot Maven插件用于应用运行和可执行包打包等构建任务。 -->
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
